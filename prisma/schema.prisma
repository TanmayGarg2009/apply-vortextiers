generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String          @id @default(cuid())
  discordId         String          @unique
  discordUsername   String
  discordGlobalName String?
  discordAvatar     String?
  email             String
  role              Role            @default(APPLICANT)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  lastLoginAt       DateTime        @default(now())
  adminNotes        AdminNote[]
  reviewedApps      Application[]   @relation("ReviewerApplications")
  applications      Application[]   @relation("ApplicantApplications")
  auditLogs         AuditLog[]
  statusChanges     StatusHistory[]

  @@index([role])
  @@index([email])
}

model StaffPosition {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  description      String?
  enabled          Boolean       @default(true)
  order            Int           @default(0)
  requiredEvidence Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  applications     Application[]
  questions        Question[]

  @@index([enabled, order])
}

model GameMode {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  description  String?
  icon         String?
  enabled      Boolean       @default(true)
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
  questions    Question[]

  @@index([enabled, order])
}

model Question {
  id               String         @id @default(cuid())
  positionId       String?
  modeId           String?
  title            String
  description      String?
  type             QuestionType   @default(SHORT_TEXT)
  required         Boolean        @default(false)
  order            Int            @default(0)
  enabled          Boolean        @default(true)
  minLength        Int?
  maxLength        Int?
  minSelections    Int?
  maxSelections    Int?
  minNumber        Float?
  maxNumber        Float?
  options          Json?
  allowedFileTypes Json?
  maxFiles         Int?           @default(1)
  maxFileSizeMb    Int?           @default(25)
  version          Int            @default(1)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  answers          Answer[]
  mode             GameMode?      @relation(fields: [modeId], references: [id], onDelete: Cascade)
  position         StaffPosition? @relation(fields: [positionId], references: [id], onDelete: Cascade)
  uploads          Upload[]

  @@index([positionId, modeId, enabled, order])
  @@index([enabled, order])
}

model Application {
  id                  String            @id
  userId              String
  discordId           String
  email               String
  minecraftUsername   String?
  positionId          String
  modeId              String?
  status              ApplicationStatus @default(DRAFT)
  version             Int               @default(1)
  submittedAt         DateTime?
  reviewedAt          DateTime?
  reviewedById        String?
  decisionReason      String?
  acceptanceMessage   String?
  rejectionReason     String?
  googleDriveFolderId String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  adminNotes          AdminNote[]
  answers             Answer[]
  mode                GameMode?         @relation(fields: [modeId], references: [id], onDelete: SetNull)
  position            StaffPosition     @relation(fields: [positionId], references: [id])
  reviewedBy          User?             @relation("ReviewerApplications", fields: [reviewedById], references: [id], onDelete: SetNull)
  user                User              @relation("ApplicantApplications", fields: [userId], references: [id], onDelete: Cascade)
  emailEvents         EmailEvent[]
  statusHistory       StatusHistory[]
  uploads             Upload[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([positionId, createdAt(sort: Desc)])
  @@index([modeId, createdAt(sort: Desc)])
  @@index([submittedAt(sort: Desc)])
  @@index([reviewedById])
}

model Answer {
  id               String      @id @default(cuid())
  applicationId    String
  questionId       String
  questionSnapshot Json?
  value            String?
  selectedOptions  Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([applicationId, questionId])
  @@index([questionId])
}

model Upload {
  id                      String         @id @default(cuid())
  applicationId           String
  questionId              String?
  filename                String
  safeFilename            String
  mimeType                String
  sizeBytes               Int
  googleDriveFileId       String         @unique
  googleDriveViewLink     String?
  googleDriveDownloadLink String?
  category                UploadCategory @default(IMAGE)
  createdAt               DateTime       @default(now())
  application             Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question                Question?      @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([questionId])
}

model AdminNote {
  id            String      @id @default(cuid())
  applicationId String
  authorId      String
  content       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt(sort: Desc)])
  @@index([authorId])
}

model StatusHistory {
  id            String            @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus
  toStatus      ApplicationStatus
  changedById   String?
  note          String?
  metadata      Json?
  createdAt     DateTime          @default(now())
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy     User?             @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt(sort: Desc)])
}

model EmailEvent {
  id                String      @id @default(cuid())
  applicationId     String
  recipient         String
  type              EmailType
  status            EmailStatus @default(PENDING)
  provider          String      @default("RESEND")
  providerMessageId String?
  attempts          Int         @default(1)
  sentAt            DateTime?
  failedAt          DateTime?
  error             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, type, status])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt(sort: Desc)])
}

model AppSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

enum Role {
  APPLICANT
  REVIEWER
  ADMIN
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_CHANGES
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum QuestionType {
  SHORT_TEXT
  PARAGRAPH
  MULTIPLE_CHOICE
  CHECKBOXES
  DROPDOWN
  NUMERIC
  FILE_UPLOAD
  MINECRAFT_IGN
}

enum UploadCategory {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

enum EmailType {
  APPLICATION_SUBMITTED
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  STAFF_NOTIFICATION
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}
