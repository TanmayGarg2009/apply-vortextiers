# ==============================================================================
# Vortex Tiers Staff Application Platform — Environment Variables
# ==============================================================================

# Discord OAuth2 Configuration
# Scopes required: identify, email
# In production on Vercel, set these via Vercel Project Settings > Environment Variables
DISCORD_CLIENT_ID=1422296301768540240
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=https://apply.vortextiers.xyz/api/auth/callback
DISCORD_OAUTH_URL=https://discord.com/oauth2/authorize?client_id=1422296301768540240&response_type=code&redirect_uri=https%3A%2F%2Fapply.vortextiers.xyz%2Fapi%2Fauth%2Fcallback&scope=identify+email

# Initial Admin Bootstrap (Comma-separated Discord snowflake IDs)
# Any user logging in with these Discord IDs is automatically granted the ADMIN role
ADMIN_DISCORD_IDS=

# Session Security Secret (32+ chars random string for HMAC-SHA256 signing)
SESSION_SECRET=vortex_staff_session_secret_change_me_in_production_32_chars_min

# Database Connection (Supabase PostgreSQL via Prisma)
DATABASE_URL=postgresql://postgres.xxx:xxx@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxx:xxx@aws-0-xx.pooler.supabase.com:5432/postgres

# Supabase API (Optional direct client fallback)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Drive Storage (Service Account)
# Service account must have Editor access to GOOGLE_DRIVE_ROOT_FOLDER_ID
GOOGLE_CLIENT_EMAIL=vortex-tiers-staff-app@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_google_drive_folder_id_here

# Resend Transactional Email Service
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=no-reply@vortextiers.xyz

# Application Public URL
NEXT_PUBLIC_APP_URL=https://apply.vortextiers.xyz
